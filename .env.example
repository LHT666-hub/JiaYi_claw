# Shared AI gateway. Keep all API keys server-side and out of Git.
AI_PROVIDER=aliyun_bailian
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.8-flash
AI_VISION_MODEL=qwen3.7-plus
MEMORY_EXTRACTION_MODEL=qwen3.8-flash
RAG_GENERATION_MODEL=qwen3.7-plus
RAG_GENERATION_ENABLED=true
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
ASR_PROVIDER=bailian_qwen_asr
ASR_MODEL=qwen3-asr-flash
AI_RESPONSE_TIMEOUT_MS=12000
RAG_GENERATION_TIMEOUT_MS=12000
PUBLIC_INFO_TIMEOUT_MS=1800
RAG_EMBEDDING_DIMENSIONS=1024

# Legacy Moonshot variables remain supported during migration.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_VISION_MODEL=kimi-k2.6
