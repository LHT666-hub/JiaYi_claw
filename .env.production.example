# Copy this file to .env.production.local. Never commit real secrets.

# Public application URLs
NEXT_PUBLIC_APP_URL=https://lht11.me
TARO_APP_API_BASE_URL=https://lht11.me

# Production Supabase project. Use a mainland-hosted environment before real health data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WeChat mini program credentials from mp.weixin.qq.com
WECHAT_MINIPROGRAM_APP_ID=wx0000000000000000
WECHAT_MINIPROGRAM_APP_SECRET=your_wechat_miniprogram_secret
WECHAT_MINIPROGRAM_STATE=jiayi-claw

# One-time subscription message for service/appointment updates.
# Replace the field names with those shown in the selected WeChat template.
WECHAT_SUBSCRIBE_SERVICE_TEMPLATE_ID=your_service_template_id
WECHAT_SUBSCRIBE_SERVICE_FIELD_MAP={"title":"thing1","status":"phrase2","updatedAt":"time3","note":"thing4"}

# Optional second template for follow-up reminders.
WECHAT_SUBSCRIBE_FOLLOWUP_TEMPLATE_ID=
WECHAT_SUBSCRIBE_FOLLOWUP_FIELD_MAP=

# Operator shown in privacy policy and customer support.
NEXT_PUBLIC_OPERATOR_NAME=your_verified_operator_name
NEXT_PUBLIC_PRIVACY_CONTACT=your_privacy_contact

# Tencent Cloud SMS used by the Supabase Send SMS Hook.
TENCENT_SMS_SECRET_ID=your_tencent_sms_secret_id
TENCENT_SMS_SECRET_KEY=your_tencent_sms_secret_key
TENCENT_SMS_APP_ID=your_tencent_sms_app_id
TENCENT_SMS_SIGN_NAME=your_approved_sms_sign_name
TENCENT_SMS_TEMPLATE_ID=your_approved_sms_template_id
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_PARAM_KEYS=otp,ttlMinutes
TENCENT_SMS_OTP_TTL_MINUTES=5
SUPABASE_SEND_SMS_HOOK_SECRET=whsec_your_standard_webhooks_secret
TENCENT_SMS_SECURITY_TOKEN=

# Aliyun Bailian / Model Studio. Keep the real API key only in the deployment
# secret store (Vercel or the institution server), never in Git.
AI_PROVIDER=aliyun_bailian
DASHSCOPE_API_KEY=
# Optional but recommended on the new Model Studio endpoint. If set, the app
# automatically builds the workspace-specific compatible and native API URLs.
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# Leave blank to let DASHSCOPE_WORKSPACE_ID choose the endpoint automatically.
DASHSCOPE_BASE_URL=
DASHSCOPE_NATIVE_BASE_URL=
AI_MODEL=qwen3.8-flash
AI_VISION_MODEL=qwen3.8-flash
MEMORY_EXTRACTION_MODEL=qwen3.8-flash
RAG_GENERATION_MODEL=qwen3.8-flash
AI_RESPONSE_TIMEOUT_MS=8000
RAG_GENERATION_TIMEOUT_MS=6000

# RAG retrieval. General chat bypasses RAG; only institution-specific/current
# service questions invoke retrieval. The embedding model can reuse the Bailian key.
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_GENERATION_ENABLED=true

# Speech input. Qwen-Audio 3.0 ASR Flash supports Chinese dialects including Wu;
# qwen3-asr-flash is used as an automatic compatible-API fallback.
ASR_PROVIDER=bailian_qwen_asr
ASR_MODEL=qwen-audio-3.0-asr-flash
ASR_FALLBACK_MODEL=qwen3-asr-flash
# DASHSCOPE_ASR_URL can override the native multimodal-generation endpoint.
DASHSCOPE_ASR_URL=
ASR_PYTHON_PATH=C:\\path\\to\\isolated\\python.exe
ASR_START_TIMEOUT_MS=30000
ASR_TRANSCRIBE_TIMEOUT_MS=60000
ASSISTANT_TRANSCRIPT_RETENTION=false

# Operational secrets. Generate independent random 32-byte values.
CRON_SECRET=your_random_secret_at_least_32_characters
CHANNEL_MESSAGE_ENCRYPTION_KEY=your_64_character_hex_key

# Optional official WeCom channel. Leave blank when the pilot has not enabled it.
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=
WECOM_GROUP_WEBHOOK_URL=

# Production boundaries. These must all remain false.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEV_LOGIN=false
AUTH_TEST_MODE=false
