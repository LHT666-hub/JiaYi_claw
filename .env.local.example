NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional_server_only

KIMI_API_KEY=your_kimi_api_key
# Optional compatibility aliases:
# MOONSHOT_API_KEY=your_kimi_api_key
# OPENAI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_VISION_MODEL=kimi-k2.6

# RAG uses reviewed public/service content only. Without an embedding provider,
# retrieval safely falls back to tenant-filtered keyword search.
RAG_EMBEDDING_PROVIDER=deterministic
RAG_ALLOW_DETERMINISTIC=true
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_GENERATION_ENABLED=true
AI_PROVIDER=aliyun_bailian
AI_MODEL=qwen3.8-flash
AI_VISION_MODEL=qwen3.7-plus
MEMORY_EXTRACTION_MODEL=qwen3.8-flash
RAG_GENERATION_MODEL=qwen3.7-plus

NEXT_PUBLIC_ASK_TIMEOUT_MS=30000
# Formal mode keeps only structured Skill run metadata, not full chat text.
ASSISTANT_TRANSCRIPT_RETENTION=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OPERATOR_NAME=家医 Claw 本地开发
NEXT_PUBLIC_PRIVACY_CONTACT=仅用于本地开发

# WeChat Mini Program one-click phone login. Keep secrets server-side.
TARO_APP_API_BASE_URL=http://localhost:3000
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_STATE=developer
WECHAT_SUBSCRIBE_SERVICE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_SERVICE_FIELD_MAP=
WECHAT_SUBSCRIBE_FOLLOWUP_TEMPLATE_ID=
WECHAT_SUBSCRIBE_FOLLOWUP_FIELD_MAP=

# Local Whisper-Wu speech recognition. The default path targets the bundled
# Windows Python environment; production can point to an isolated ASR worker.
ASR_PROVIDER=bailian_qwen_asr
ASR_MODEL=qwen-audio-3.0-asr-flash
# DASHSCOPE_ASR_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_PYTHON_PATH=
ASR_START_TIMEOUT_MS=120000
ASR_TRANSCRIBE_TIMEOUT_MS=60000

# Demo identities and localStorage fallbacks are disabled unless explicitly enabled.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEV_LOGIN=false

# Phone OTP is delivered by Supabase Auth. Production should configure a
# Supabase Send SMS Hook backed by Tencent Cloud SMS.
AUTH_TEST_MODE=false
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
SUPABASE_SEND_SMS_HOOK_SECRET=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_PARAM_KEYS=otp
TENCENT_SMS_OTP_TTL_MINUTES=5
TENCENT_SMS_SECURITY_TOKEN=

# Required for the reliable notification outbox worker.
CRON_SECRET=

# Official WeCom channel. Secrets remain server-side and are never stored in
# channel records or returned to browsers.
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=
WECOM_GROUP_WEBHOOK_URL=
# 32-byte key as 64 hex chars or base64, used for seven-day message retention.
CHANNEL_MESSAGE_ENCRYPTION_KEY=
